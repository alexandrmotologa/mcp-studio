{
  "name": "mcp-studio",
  "version": "2.1.8",
  "description": "Open Source Desktop Inspector & Protocol Suite for Model Context Protocol (MCP)",
  "homepage": "https://mcp.mtlglabs.space",
  "main": "./out/main/index.js",
  "author": {
    "name": "Alexandr Motologa & MTLG Labs",
    "url": "https://mtlg.site",
    "email": "support@mtlglabs.space"
  },
  "organization": {
    "name": "MTLG Labs",
    "url": "https://mtlglabs.space"
  },
  "links": {
    "official": "https://mcp.mtlglabs.space",
    "personal": "https://mtlg.site",
    "labs": "https://mtlglabs.space",
    "github": "https://github.com/alexandrmotologa/mcp-studio",
    "linkedin": "https://linkedin.com/in/alexandr-motologa"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alexandrmotologa/mcp-studio.git"
  },
  "license": "MIT",
  "private": false,
  "scripts": {
    "test": "vitest run",
    "format": "prettier --write .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "start": "electron-vite preview",
    "dev": "electron-vite dev",
    "dev:web": "vite --open",
    "build": "npm run typecheck && electron-vite build",
    "export:oss": "node scripts/export-oss.mjs",
    "export:oss:dry": "node scripts/export-oss.mjs --dry-run",
    "postinstall": "electron-builder install-app-deps",
    "build:win": "npm run build && electron-builder --win --config --publish never",
    "build:mac": "npm run build && electron-builder --mac --config --publish never",
    "build:linux": "npm run build && electron-builder --linux --config --publish never"
  },
  "dependencies": {
    "@electron-toolkit/utils": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.6.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.13.5",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^3.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.3",
    "prettier": "^3.5.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^6.1.1",
    "vitest": "^4.1.11"
  }
}